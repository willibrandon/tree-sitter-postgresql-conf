{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "postgresql_conf",
  "word": "_word",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_entry"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_entry"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_entry": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "setting"
        },
        {
          "type": "SYMBOL",
          "name": "include"
        },
        {
          "type": "SYMBOL",
          "name": "hba_rule"
        },
        {
          "type": "SYMBOL",
          "name": "user_mapping"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\r\\n]*"
    },
    "_word": {
      "type": "PATTERN",
      "value": "[A-Za-z_.$][^\\s=#'\",]*"
    },
    "setting": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_word"
            },
            "named": true,
            "value": "setting_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "="
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_value"
          }
        }
      ]
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "boolean"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_word"
          },
          "named": true,
          "value": "bare_value"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "'([^'\\r\\n]|'')*'"
    },
    "number": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?"
            }
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PATTERN",
                  "value": "[A-Za-z]+"
                }
              },
              "named": true,
              "value": "unit"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "boolean": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[oO][nN]|[oO][fF][fF]|[tT][rR][uU][eE]|[fF][aA][lL][sS][eE]|[yY][eE][sS]|[nN][oO]"
        }
      }
    },
    "include": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "include"
            },
            {
              "type": "STRING",
              "value": "include_if_exists"
            },
            {
              "type": "STRING",
              "value": "include_dir"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "="
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\\s'\"#=][^\\s#]*"
                },
                "named": true,
                "value": "path"
              }
            ]
          }
        }
      ]
    },
    "hba_rule": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "type",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "STRING",
                  "value": "local"
                },
                "named": true,
                "value": "connection_type"
              }
            },
            {
              "type": "FIELD",
              "name": "database",
              "content": {
                "type": "SYMBOL",
                "name": "database"
              }
            },
            {
              "type": "FIELD",
              "name": "user",
              "content": {
                "type": "SYMBOL",
                "name": "user"
              }
            },
            {
              "type": "FIELD",
              "name": "method",
              "content": {
                "type": "SYMBOL",
                "name": "auth_method"
              }
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "FIELD",
                "name": "option",
                "content": {
                  "type": "SYMBOL",
                  "name": "auth_option"
                }
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "type",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "host"
                    },
                    {
                      "type": "STRING",
                      "value": "hostssl"
                    },
                    {
                      "type": "STRING",
                      "value": "hostnossl"
                    },
                    {
                      "type": "STRING",
                      "value": "hostgssenc"
                    },
                    {
                      "type": "STRING",
                      "value": "hostnogssenc"
                    }
                  ]
                },
                "named": true,
                "value": "connection_type"
              }
            },
            {
              "type": "FIELD",
              "name": "database",
              "content": {
                "type": "SYMBOL",
                "name": "database"
              }
            },
            {
              "type": "FIELD",
              "name": "user",
              "content": {
                "type": "SYMBOL",
                "name": "user"
              }
            },
            {
              "type": "FIELD",
              "name": "address",
              "content": {
                "type": "SYMBOL",
                "name": "address"
              }
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "FIELD",
                  "name": "netmask",
                  "content": {
                    "type": "ALIAS",
                    "content": {
                      "type": "SYMBOL",
                      "name": "ip_address"
                    },
                    "named": true,
                    "value": "netmask"
                  }
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "FIELD",
              "name": "method",
              "content": {
                "type": "SYMBOL",
                "name": "auth_method"
              }
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "FIELD",
                "name": "option",
                "content": {
                  "type": "SYMBOL",
                  "name": "auth_option"
                }
              }
            }
          ]
        }
      ]
    },
    "database": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_hba_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_hba_name"
              }
            ]
          }
        }
      ]
    },
    "user": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_hba_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_hba_name"
              }
            ]
          }
        }
      ]
    },
    "_hba_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_word"
          },
          "named": true,
          "value": "name"
        },
        {
          "type": "SYMBOL",
          "name": "role_group"
        },
        {
          "type": "SYMBOL",
          "name": "file_reference"
        },
        {
          "type": "SYMBOL",
          "name": "regex"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_name"
        }
      ]
    },
    "role_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_word"
          },
          "named": true,
          "value": "name"
        }
      ]
    },
    "file_reference": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "PATTERN",
              "value": "[^\\s,#\"]+"
            }
          },
          "named": true,
          "value": "path"
        }
      ]
    },
    "regex": {
      "type": "PATTERN",
      "value": "\\/[^\\s,#\"]*"
    },
    "quoted_name": {
      "type": "PATTERN",
      "value": "\"[^\"\\r\\n]*\""
    },
    "address": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "ip_address"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_word"
          },
          "named": true,
          "value": "hostname"
        }
      ]
    },
    "ip_address": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "\\d{1,3}(\\.\\d{1,3}){3}(\\/\\d{1,3})?"
            },
            {
              "type": "PATTERN",
              "value": "[0-9A-Fa-f]*:[0-9A-Fa-f:.]*(\\/\\d{1,3})?"
            }
          ]
        }
      }
    },
    "auth_method": {
      "type": "SYMBOL",
      "name": "_word"
    },
    "auth_option": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_word"
            },
            "named": true,
            "value": "option_name"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "quoted_name"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\\s#\"]+"
                },
                "named": true,
                "value": "option_value"
              }
            ]
          }
        }
      ]
    },
    "user_mapping": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "map",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_word"
            },
            "named": true,
            "value": "map_name"
          }
        },
        {
          "type": "FIELD",
          "name": "system_user",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_word"
                },
                "named": true,
                "value": "system_user"
              },
              {
                "type": "SYMBOL",
                "name": "regex"
              },
              {
                "type": "SYMBOL",
                "name": "quoted_name"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "database_user",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_word"
                },
                "named": true,
                "value": "database_user"
              },
              {
                "type": "SYMBOL",
                "name": "quoted_name"
              },
              {
                "type": "SYMBOL",
                "name": "backreference"
              }
            ]
          }
        }
      ]
    },
    "backreference": {
      "type": "PATTERN",
      "value": "\\\\\\d+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}